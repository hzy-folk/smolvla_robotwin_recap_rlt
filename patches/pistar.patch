 class GemmaBlockRunner(Gemma3_270M):
     """Extends Gemma3_270M to allow running the backbone with continuous embeddings."""
+
+    def _apply_attention(self, inputs, cache=None):
+        x = inputs.embeddings
+        old_cache = cache or {}
+        new_cache = {}
+        for index, block in enumerate(self.blocks):
+            layer_name = f"layer_{index}"
+            run_block = lambda hidden, positions, layer_cache, attention_mask: block(
+                hidden, positions, layer_cache, attention_mask
+            )
+            layer_cache, x = jax.checkpoint(run_block)(
+                x,
+                inputs.positions,
+                old_cache.get(layer_name),
+                inputs.attention_mask,
+            )
+            new_cache[layer_name] = layer_cache
+        return self.final_norm(x), new_cache
     
