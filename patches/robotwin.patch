+            for actor in scene.get_all_actors():
+                if actor.get_name().startswith('table'):
+                    for finger in ['fl_link7','fl_link8','fr_link7','fr_link8']:
+                        self.planner.acm.set_entry(finger, actor.get_name(), True)
